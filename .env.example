OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=agentic-ai-index

# Optional. Set this to talk to a running FastAPI backend (uvicorn app:app --reload).
# Leave it unset and the Streamlit UI runs the RAG pipeline in-process, which is how
# the Streamlit Community Cloud deployment works - there is no uvicorn process there.
# RAG_API_URL=http://127.0.0.1:8000

# Optional. RAG_API_MODE=mock serves clearly-labelled sample data, for UI work without keys.
